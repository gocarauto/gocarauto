# ==============================================================================
# GoCar Auto (SFMS) - Environment Configuration Template
# Copy this file to .env and populate with your production or local values.
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# JWT Security
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# Database Configuration
# Options: 'sqlite' or 'mysql'
DB_TYPE=sqlite
DB_PATH=database/gocar_auto.db

# MySQL Settings (Only when DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=gocar_user
DB_PASSWORD=your_secure_db_password
DB_NAME=gocar_auto

# Network & Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email Notification Gateway (SMTP / Gmail / SendGrid)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_email_app_password

# Puppeteer Chromium Path (Optional override for Docker / Custom VPS)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Company Branding & Invoice Metadata
COMPANY_NAME="GoCar Auto"
COMPANY_ADDRESS="Cairo, Egypt"
COMPANY_PHONE="+20 106 661 5092"
COMPANY_EMAIL="go2carauto@gmail.com
INVOICE_PREFIX=INV-

# Customer Portal URL (used for generating Magic Links)
CUSTOMER_PORTAL_URL=http://localhost:5174

# Antigravity & Stitch API Gateway Tokens (Optional)
ANTIGRAVITY_API_KEY=
STITCH_API_ACCESS_TOKEN=
STITCH_WORKSPACE_ID=
ENV_MODE=development
